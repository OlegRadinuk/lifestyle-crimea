# Uploaded apartment images (UUID-named files created by the admin upload route).
# Pattern *-*.webp matches UUIDs (which contain dashes) but NOT the original
# numbered files (1.webp, 2.webp, …) that are intentionally tracked.
# Once UPLOADS_ROOT is configured on the server, new uploads land outside the
# repo entirely and this rule only matters for local development.
public/images/apartments/*/*-*.webp

# Backup directory (created by devops rotation scripts, not part of source).
backups/
# Uploads directory (files stored outside git, served via symlink)
/uploads/
# Pre-imagefix backup directories (safety copies, not source code)
*.pre-imagefix/

# DB backups with date suffixes like data.sqlite.backup-20260304.
# (The patterns *.sqlite and data.sqlite-shm/wal are already above, but
# date-suffixed backups use a different extension and need an explicit glob.)
data.sqlite.*

# Screenshots / design artifacts
*.png
*.jpeg
*.jpg
слайды\ херо/

# ...но НЕ боевые ассеты сайта. Глухие *.png/*.jpg выше молча съедали всё
# новое в public/: так `og-image.jpg` (превью для Telegram/WhatsApp/VK) и
# `logo.png` (logo в schema.org) никогда не доехали до прода и отдавали 404,
# хотя разметка на них ссылалась. Старые картинки в public/images/ лежат в
# индексе только потому, что их добавили ДО появления этих правил.
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg

